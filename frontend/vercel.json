{
  "version": 2,
  "name": "chatbot-frontend",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    }
  ],
  "env": {
    "BACKEND_URL": "https://your-backend-url.railway.app"
  }
}
